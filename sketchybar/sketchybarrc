#!/usr/bin/env bash

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"

# Colors (discOS palette, see colors.sh)
source "$CONFIG_DIR/colors.sh"

# Fonts. Upstream uses Berkeley Mono + Symbols Nerd Font; JetBrainsMono
# Nerd Font covers both text and icons.
FONT="JetBrainsMono Nerd Font"

##############################
#  Bar – Transparent         #
##############################

# OmniWM's outer top gap must clear y_offset + height
# (see omniwm/settings.toml [gaps.outer]).
sketchybar --bar position=top \
                height=40 \
                color=0x00000000 \
                shadow=off \
                sticky=on \
                padding_left=7 \
                padding_right=7 \
                corner_radius=0 \
                border_width=0 \
                blur_radius=0 \
                y_offset=2

################################
#  Global defaults             #
################################

MODULE_BG_ALPHA="d0"       # More opaque for visibility
MODULE_BORDER_ALPHA="40"   # Subtle borders

default=(
  padding_left=6
  padding_right=6

  icon.font="$FONT:Bold:16.0"
  label.font="$FONT:Medium:13.0"

  icon.font.size=16.0
  label.font.size=13.0

  icon.color=0xff${LOVE:2}
  label.color=0xff${FG_PRIMARY:2}

  icon.padding_left=6
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=6

  background.color=0x${MODULE_BG_ALPHA}${BG_SURFACE:2}
  background.corner_radius=10
  background.height=28
  background.border_width=1
  background.border_color=0x${MODULE_BORDER_ALPHA}${LOVE:2}
  background.shadow.drawing=off
)

sketchybar --default "${default[@]}"

################################
#  LEFT: Portal + Spaces       #
################################

sketchybar --add item portal left \
           --set portal icon= \
                        icon.font="$FONT:Regular:18.0" \
                        icon.color=0xff${ROSE:2} \
                        background.color=0x00000000 \
                        background.corner_radius=0 \
                        background.border_width=0 \
                        background.shadow.drawing=off \
                        label.drawing=off \
                        icon.padding_left=7 \
                        icon.padding_right=7 \
                        padding_left=3 \
                        click_script="sketchybar --reload"

sketchybar --add item cosmic_sep left \
           --set cosmic_sep icon=│ \
                           icon.color=0x40${FG_DIM:2} \
                           background.drawing=off \
                           label.drawing=off \
                           icon.padding_left=3 \
                           icon.padding_right=3

############################
#  Workspaces              #
############################

# Same glyph for every workspace; the colors tell them apart. SPACE_COLORS
# comes from colors.sh and never matches the highlight (JankyBorders' color).
SPACE_ICON="󰻃"

# "number<TAB>rawName" per workspace (empty if OmniWM isn't running yet)
OMNIWM_SPACES="$(omniwmctl query workspaces --format json 2>/dev/null |
  jq -r '.result.payload.workspaces[] | "\(.number)\t\(.rawName)"' 2>/dev/null)"

i=0
while IFS=$'\t' read -r num raw; do
  [ -z "$raw" ] && continue
  space_color="${SPACE_COLORS[i % ${#SPACE_COLORS[@]}]}"
  space=(
    icon="$SPACE_ICON"
    icon.color=0xb0$space_color
    icon.highlight_color=0xff${HIGHLIGHT:2}
    icon.font.size=15.0
    background.color=0x00000000
    background.corner_radius=8
    background.border_width=0
    background.height=24
    background.shadow.drawing=off
    label.drawing=off
    label.color=0xff${FG_PRIMARY:2}
    label.font="$FONT:Regular:14.0"
    label.padding_left=3
    label.padding_right=3
    click_script="omniwmctl command switch-workspace $num"
  )

  sketchybar --add item "omniwm_space.$raw" left \
             --set "omniwm_space.$raw" "${space[@]}"
  i=$((i + 1))
done <<<"$OMNIWM_SPACES"

# Run once at startup, then rely on OmniWM events. The watcher outlives
# sketchybar, so replace any instance left over from a previous load.
"$PLUGIN_DIR/omniwm_workspaces.sh"
pkill -f 'omniwmctl watch .*(omniwm_update|omniwm_workspaces)' 2>/dev/null
nohup omniwmctl watch active-workspace,windows-changed,layout-changed \
  --no-send-initial --reconnect --exec "$PLUGIN_DIR/omniwm_workspaces.sh" \
  >/dev/null 2>&1 &
disown

################################
#  RIGHT: System Monitors      #
################################

sketchybar --add item clock right \
           --set clock icon=󰥔 \
                      icon.font.size=16.0 \
                      icon.color=0xff${LOVE:2} \
                      label.color=0xff${FG_PRIMARY:2} \
                      label.font="$FONT:SemiBold:13.0" \
                      background.color=0x00000000 \
                      background.corner_radius=0 \
                      background.padding_left=7 \
                      background.padding_right=7 \
                      background.border_width=0 \
                      background.shadow.drawing=off \
                      label.padding_left=6 \
                      label.padding_right=8 \
                      update_freq=1 \
                      script="$PLUGIN_DIR/clock.sh"

sketchybar --add item battery right \
           --set battery icon=󰁹 \
                        icon.font="$FONT:Regular:16.0" \
                        icon.color=0xff${PINE:2} \
                        label.color=0xff${FG_PRIMARY:2} \
                        background.color=0x00000000 \
                        background.corner_radius=0 \
                      background.padding_left=7 \
                      background.padding_right=7 \
                        background.border_width=0 \
                        background.shadow.drawing=off \
                        update_freq=60 \
                        script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change

sketchybar --add item volume right \
           --set volume icon=󰕾 \
                       icon.font.size=16.0 \
                       icon.color=0xff${ROSE:2} \
                       label.color=0xff${FG_PRIMARY:2} \
                       background.color=0x00000000 \
                       background.corner_radius=0 \
                       background.border_width=0 \
                      background.padding_left=7 \
                      background.padding_right=7 \
                       background.shadow.drawing=off \
                       update_freq=5 \
                       script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change

#################
#  Final launch #
#################

sketchybar --update
